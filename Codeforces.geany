[project]
name=Codeforces
description=Raiz de trabajo para programacion competitiva
base_path=/root/cp_test/CodeForces/
file_patterns=*.c;*.h;*.cpp;*.cxx;*.cc;*.hpp;*.py;*.txt;*.in;*.out;*.ans;

[editor]
line_wrapping=false
line_break_column=100
auto_continue_multiline=true

[file_prefs]
final_new_line=true
ensure_convert_new_lines=false
strip_trailing_spaces=true
replace_tabs=true

[indentation]
indent_width=4
indent_type=1
indent_hard_tab_width=8
detect_indent=false
detect_indent_width=false
indent_mode=2

[long line marker]
long_line_behaviour=1
long_line_column=72

